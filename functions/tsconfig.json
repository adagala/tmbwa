{
  "compilerOptions": {
    "module": "commonjs",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "rootDir": ".",
    "sourceMap": true,
    "strict": true,
    "target": "es2017",
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "references": [
    {"path": "../packages/shared"}
  ],
  "compileOnSave": true,
  "include": ["src/**/*"],
  "exclude": ["node_modules", "src/scripts/**/*"]
}
