rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdministrator() {
      return signedIn() && request.auth.token.role == 'administrator';
    }

    function isOwner(memberId) {
      return signedIn() && request.auth.uid == memberId;
    }

    function ownerProfileFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'firstname',
        'lastname',
        'membernumber',
        'win',
        'phonenumber',
        'gender'
      ]);
    }

    function administratorMemberFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'firstname', 'lastname', 'email', 'role', 'membernumber', 'win',
        'phonenumber', 'status', 'gender', 'isFeesPaid'
      ]);
    }

    match /members/{memberId} {
      allow get: if isAdministrator() || isOwner(memberId);
      allow list: if isAdministrator();
      allow create, delete: if isAdministrator();
      allow update: if (isAdministrator() && administratorMemberFieldsOnly()) ||
        (isOwner(memberId) && ownerProfileFieldsOnly());

      match /contributions/{contributionId} {
        allow read: if isAdministrator() || isOwner(memberId);
        allow write: if false;
      }

      match /payments/{paymentId} {
        allow read: if isAdministrator() || isOwner(memberId);
        allow write: if false;
      }
    }

    match /monthly_stats/{statId} {
      allow read: if isAdministrator();
      allow write: if false;
    }

    match /stats/{statId} {
      allow read, write: if isAdministrator();
    }

    match /financial_commands/{commandId} {
      allow read, write: if false;
    }

    match /audit_events/{eventId} {
      allow read: if isAdministrator();
      allow write: if false;
    }

    match /contribution_rates/{rateId} {
      allow read: if isAdministrator();
      allow create: if isAdministrator() &&
        request.resource.data.keys().hasOnly(['amount', 'effectiveFrom', 'updatedAt', 'updatedBy']) &&
        request.resource.data.amount is number && request.resource.data.amount > 0 &&
        request.resource.data.effectiveFrom is string &&
        request.resource.data.effectiveFrom.matches('^\\d{4}-(0[1-9]|1[0-2])-01$');
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
